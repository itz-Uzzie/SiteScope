# Optional AI explanations. The app can use its rule-based fallback without keys.
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional Google PageSpeed Insights API key.
PSI_API_KEY=

# Deployed base URL used for canonical metadata, breadcrumbs, robots.txt, and sitemap URLs.
SITE_URL=https://your-project.vercel.app
# Legacy fallback for deployments that still use the old variable name.
NEXT_PUBLIC_SITE_URL=

# Optional shared rate limiting across serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
